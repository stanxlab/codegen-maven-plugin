package ${package.Controller};

import javax.validation.Valid;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.*;
import ${commonResultClass};
import ${dtoPackage}.${originalEntityName}DTO;
import ${converterPackage}.${originalEntityName}Converter;
import ${pageInfoClass};
import ${pageRequestClass};
<% if(isNotEmpty(superControllerClassPackage)){ %>
import ${superControllerClassPackage};
<% } %>
import ${package.Entity}.${entity};
import ${package.Service}.${table.serviceName};
import io.swagger.annotations.ApiOperation;
import lombok.extern.slf4j.Slf4j;
import lombok.RequiredArgsConstructor;

import java.util.List;

/**
 * <p>
 * ${table.comment!} Controller
 * </p>
 *
 * @author ${author}
 * @since ${date}
 */
@Slf4j
@Validated
@RestController
@RequestMapping("<% if(isNotEmpty(moduleName)){ %>/${moduleName}<% } %>/${lowEntityName}")
@RequiredArgsConstructor
public class ${originalEntityName}Controller <% if(isNotEmpty(superControllerName)){ %>extends ${superControllerName}<% } %> {

    private final ${table.serviceName} ${lowEntityName}Service;

    @ApiOperation("获取分页")
    @GetMapping("/page")
    public ${commonResultClassName}<${pageInfoClassName}<${entity}>> page(@RequestParam(name = "pageNo", defaultValue = "1", required = false) Integer pageNo,
                                              @RequestParam(name = "pageSize", defaultValue = "10", required = false) Integer pageSize)  {
        ${pageInfoClassName}<${entity}> res = ${lowEntityName}Service.page(new ${pageRequestClassName}(pageNo, pageSize), null);
        return ${commonResultClassName}.success(res);
    }

    @ApiOperation("详情")
    @GetMapping("/detail")
    public ${commonResultClassName}<${originalEntityName}DTO> detail(@RequestParam Long id) {
        ${entity} res = ${lowEntityName}Service.getById(id);
        ${originalEntityName}DTO ${lowEntityName}DTO = ${originalEntityName}Converter.INSTANCE.to${originalEntityName}DTO(res);
        return ${commonResultClassName}.success(${lowEntityName}DTO);
    }

    @ApiOperation("新增")
    @PostMapping("/add")
    public ${commonResultClassName}<Boolean> add(@Valid @RequestBody ${originalEntityName}DTO ${lowEntityName}) {
        ${entity} ${lowEntityName}<% if(isNotEmpty(entitySuffix)){ %>${entitySuffix}<% } %> = ${originalEntityName}Converter.INSTANCE.to${originalEntityName}<% if(isNotEmpty(entitySuffix)){ %>${entitySuffix}<% } %>(${lowEntityName});
        Boolean res = ${lowEntityName}Service.save(${lowEntityName}<% if(isNotEmpty(entitySuffix)){ %>${entitySuffix}<% } %>);
        return ${commonResultClassName}.success(res);
    }

    @ApiOperation("更新")
    @PostMapping("/update")
    public ${commonResultClassName}<Boolean> update(@Valid @RequestBody ${originalEntityName}DTO ${lowEntityName}) {
        ${entity} ${lowEntityName}<% if(isNotEmpty(entitySuffix)){ %>${entitySuffix}<% } %> = ${originalEntityName}Converter.INSTANCE.to${originalEntityName}<% if(isNotEmpty(entitySuffix)){ %>${entitySuffix}<% } %>(${lowEntityName});
        Boolean res = ${lowEntityName}Service.updateById(${lowEntityName}<% if(isNotEmpty(entitySuffix)){ %>${entitySuffix}<% } %>);
        return ${commonResultClassName}.success(res);
    }

    @ApiOperation("删除")
    @PostMapping("/delete")
    public ${commonResultClassName}<Boolean> delete(@RequestParam Long id) {
        Boolean res = ${lowEntityName}Service.removeById(id);
        return ${commonResultClassName}.success(res);
    }

}
