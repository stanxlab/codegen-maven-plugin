package ${converterPackage};


import ${package.Entity}.${entity};
import ${dtoPackage}.${originalEntityName}DTO;
import org.mapstruct.Mapper;
import org.mapstruct.Mapping;
import org.mapstruct.Mappings;
import org.mapstruct.factory.Mappers;

@Mapper
public interface ${originalEntityName}Converter {
    ${originalEntityName}Converter INSTANCE = Mappers.getMapper(${originalEntityName}Converter.class);

    // 格式转换
    //@Mappings({
    //        @Mapping(source = "id", target = "id"),
    //        @Mapping(source = "createTime", target = "createTime", dateFormat = DatePattern.NORM_DATETIME_PATTERN)
    //})
    ${originalEntityName}DTO to${originalEntityName}DTO(${entity} model);

    ${entity} to${originalEntityName}(${originalEntityName}DTO model);

}
